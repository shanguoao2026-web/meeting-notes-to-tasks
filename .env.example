# SpaceXAI is served by the xAI API (OpenAI-compatible).
# Create a key at https://console.x.ai and export it. Never commit the real value.
XAI_API_KEY=

# Optional. Used when XAI_API_KEY is unset.
# OPENAI_API_KEY=

# Optional overrides. Flags win over these variables.
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.7
